---
// "/src/pages/index.astro"
import { Image } from 'astro:assets';
import LongLogo from '../assets/LongLogo.svg';
import CoverLayout from '../layouts/CoverLayout.astro';
import Hero from '../components/Hero.astro';
---
<CoverLayout title="PRR628CRAFT <3">
    <Hero height="14.7em">
        <div id="home-hero__cta">
            <Image id="hero-logo" src={LongLogo}" height="123em" alt="PRR628CRAFT"/>
            <p id="hero-content__paragraph">Master of none! I work on a lot of things! This is my blog and the official home for my projects :3</p>
            <div id="hero-button-row">
                <a class="prr-button" href="/projects">Explore</a>
                <a class="prr-button-outline" href="https://patreon.com/cw/PRR628CRAFT">Patreon</a>
            </div>
        </div>
    </Hero>
</CoverLayout>
<style>
    #home-hero__cta {
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    #hero-logo {
        height: 6em;
    }
    #hero-content__header {
        margin: 0;
    }
    #hero-content__paragraph {
        width: 20em;
        text-align: center;
    }
    #hero-button-row {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        width: 13em;
    }
    @media (min-width: 500px) {
        #hero-logo {
            height: 100%;
        }
        #hero-content__paragraph {
            width: 24em;
        }
    }
</style>