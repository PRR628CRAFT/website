---
import PrimaryLayout from "../layouts/PrimaryLayout.astro";
import ContentBlock from "../components/ContentBlock.astro";

const projectBoxes = [
    {
        name: "Personal Website",
        desc: "This very website! Part blog, part portfolio.",
        link: "website",
        tags: [
            "HTML",
            "Astro.JS",
            "Cloudflared Tunnel"
        ]
    },
    {
        name: "Pet Transfer",
        desc: "Transfer your pets in Minecraft to new owners!",
        link: "pet-transfer",
        tags: [
            "Minecraft Mod",
            "FabricMC",
            "26.2"
        ]
    },
    {
        name: "PRR628CRAFT Network",
        desc: "A network of Minecraft servers hosted by me!",
        link: "minecraft-server",
        tags: [
            "Minecraft",
            "Bedrock",
            "Java",
            "1.9 - 26.2"
        ]
    }
];
---

<PrimaryLayout title="Projects - PRR628CRAFT">
    <ContentBlock>
        <h1>PRR628's Projects</h1>
        <p>This is a collection of all of my projects over the years!</p>
    </ContentBlock>

    <div class="project-boxes">
        {
            projectBoxes.map((item) => (
                    <a class="project-link" href={`/project/${item.link}`}>
                        <div class="project-box">
                            <img
                                    class="project-box__img"
                                    src={`/assets/projects/${item.link}/thumbnail.png`}
                                    alt={item.name}
                            />

                            <h2>{item.name}</h2>
                            <p>{item.desc}</p>
                            <div class="project-tags">
                                {
                                    item.tags.map((tag) => (
                                            <span class="project-tag">
                                                {tag}
                                            </span>
                                    ))
                                }
                            </div>
                        </div>
                    </a>
            ))
        }
    </div>
</PrimaryLayout>

<style>
    .project-boxes {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 1.5rem 1rem;
        width: 100%;
    }

    .project-link {
        display: block;
        min-width: 0;
        color: white;
        text-decoration: none;
    }

    .project-box {
        height: 100%;
        overflow: hidden;
        background-color: #3232b8;
        border: 5px solid #2e2e87;
        border-radius: 10px;
        padding-bottom: 4px;
        color: white;
    }

    .project-box h2 {
        margin: 0 15px;
        margin-top: 10px;
    }

    .project-box p {
        margin: 0 15px;
    }

    .project-box__img {
        display: block;
        width: 100%;
        height: 200px;
        object-fit: cover;
    }
    .project-tags {
        display: flex;
        flex-direction: row;
        margin: 0 10px;
        margin-top: 8px;
    }
    .project-tag {
        background-color: #2e2e87;
        border-radius: 10px;
        margin: 2px;
        padding: 8px;
    }
    @media (min-width: 1048px) {
        .project-boxes {
            max-width: 1024px;
            border-radius: 10px;
        }
    }
</style>
