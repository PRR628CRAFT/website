---
// "/src/pages/404.astro"
import { Image } from 'astro:assets';
import CoverLayout from '../layouts/CoverLayout.astro';
import Hero from '../components/Hero.astro';
import ErrorImage from '../assets/404.svg';

---
<CoverLayout title="404 - PRR628CRAFT">
    <Hero height="14.7em">
        <div id="home-hero__cta">
            <Image id="hero-logo" src={ErrorImage} width="400em" height="123em" alt="Error 404"/>
            <p id="hero-content__paragraph">The page could not be found! It might have been moved or mispelled :(</p>
            <div id="hero-button-row">
                <a class="prr-button" href="/projects">Explore</a>
                <a class="prr-button-outline" href="/">Home</a>
            </div>
        </div>

    </Hero>
</CoverLayout>
<style>
    #home-hero__cta {
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    #hero-logo {
        height: 6em;
        object-fit: fill;
    }
    #hero-content__header {
        margin: 0;
    }
    #hero-content__paragraph {
        width: 20em;
        text-align: center;
    }
    #hero-button-row {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        width: 13em;
    }
    @media (min-width: 500px) {
        #hero-logo {
            height: 100%;
        }
        #hero-content__paragraph {
            width: 24em;
        }
    }
</style>