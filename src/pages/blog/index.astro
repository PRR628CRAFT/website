---
// "src/pages/blog/index.astro"
import PrimaryLayout from "../../layouts/PrimaryLayout.astro";
import ContentBlock from "../../components/ContentBlock.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
    (a, b) =>
        (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0),
);
---

<PrimaryLayout title="Blog - PRR628CRAFT">
    <ContentBlock>
        <h1>PRR628CRAFT Blog</h1>
        <p>This is my official blog, where I write about things I am interested in!</p>
    </ContentBlock>

    <div class="project-boxes">
        {posts.map((item) => (
                <a class="project-link" href={`/blog/${item.id}`}>
                    <div class="project-box">
                        <h2>{item.data.title}</h2>
                        <p>{item.data.description}</p>

                        {item.data.tags?.length > 0 && (
                                <div class="project-tags">
                                    {item.data.tags.map((tag) => (
                                            <span class="project-tag">{tag}</span>
                                    ))}
                                </div>
                        )}
                    </div>
                </a>
        ))}
    </div>
</PrimaryLayout>


<style>
    .project-boxes {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 1.5rem 1rem;
        width: 100%;
    }

    .project-link {
        display: block;
        min-width: 0;
        color: white;
        text-decoration: none;
    }

    .project-box {
        height: 100%;
        overflow: hidden;
        background-color: #3232b8;
        border: 5px solid #2e2e87;
        border-radius: 10px;
        padding-bottom: 4px;
        color: white;
    }

    .project-box h2 {
        margin: 0 15px;
        margin-top: 10px;
    }

    .project-box p {
        margin: 0 15px;
    }

    .project-box__img {
        display: block;
        width: 100%;
        height: 200px;
        object-fit: cover;
    }
    .project-tags {
        display: flex;
        flex-direction: row;
        margin: 0 10px;
        margin-top: 8px;
    }
    .project-tag {
        background-color: #2e2e87;
        border-radius: 10px;
        margin: 2px;
        padding: 8px;
    }
    @media (min-width: 1048px) {
        .project-boxes {
            max-width: 1024px;
            border-radius: 10px;
        }
    }
</style>